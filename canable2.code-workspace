{
    // CANable2-N32 工作区 —— 双击本文件即可用 VS Code 打开工程
    // （前提：已安装 VS Code 且已关联 .code-workspace 文件类型）
    //
    // 说明：
    //   - 本文件所在目录即工程根，下面的 .vscode/ 里已含
    //     tasks.json / c_cpp_properties.json / settings.json / extensions.json，
    //     打开工作区后会自动生效（Ctrl+Shift+B 构建、C/C++ 智能提示等）。
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "search.exclude": {
            "**/build": true,
            "**/.codegraph": true
        },
        "files.watcherExclude": {
            "**/build": true
        }
    }
}
