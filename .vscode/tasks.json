{
    // 构建任务 (JSONC，支持注释)
    // 依赖：make + arm-none-eabi-gcc（需先安装并加入 PATH，Windows 下可用
    // choco install gcc-arm-none-eabi make，或 MSYS2 / GNU Arm Toolchain）
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (make)",
            "type": "shell",
            "command": "make",
            "args": ["-j"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "make -j → build/canable2-n32-*.bin/.hex"
        },
        {
            "label": "Build debug ELF (make debug)",
            "type": "shell",
            "command": "make",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "make debug → 固定文件名 build/debug.elf（供将来 Cortex-Debug 调试用）"
        },
        {
            "label": "Clean (make clean)",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "删除 build/ 目录"
        },
        {
            "label": "Flash (make flash)",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "none",
            "problemMatcher": [],
            "detail": "按 BOOT 键插入 → dfu-util 烧录（README 方式；当前 make flash 只打印提示，需自行装 dfu-util）"
        }
    ]
}
